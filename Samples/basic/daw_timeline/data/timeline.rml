<rml>
<head>
	<title>KinuUI DAW Timeline</title>
	<link type="text/rcss" href="../../../assets/rml.rcss"/>
	<link type="text/rcss" href="timeline.rcss"/>
</head>
<body onmousemove="clip-drag-move" onmouseup="clip-drag-end" onmouseleave="clip-drag-end" onclick="dismiss-loop-menu">
	<div id="app">
		<nav class="menu-bar">
			<button id="menu-file">ファイル</button>
			<button onclick="project-open">開く</button>
			<button onclick="project-save">保存</button>
			<button onclick="audio-import">音声読み込み</button>
			<button onclick="audio-export">WAV書き出し</button>
			<button onclick="audio-settings">オーディオ設定</button>
			<button onclick="vst-scan">VST3再検出</button>
			<button id="menu-edit">編集</button>
			<button id="menu-select">選択</button>
			<button id="menu-view" onclick="view-menu">表示</button>
		</nav>
		<div id="view-menu" class="view-menu"><button onclick="open-mixer">ミキサー</button></div>
		<div id="snap-menu" class="snap-menu">
			<button id="snap-option-0" onclick="snap-preset:-1">OFF</button>
			<button id="snap-option-1" onclick="snap-preset:0">1/16</button>
			<button id="snap-option-2" onclick="snap-preset:1">1/8</button>
			<button id="snap-option-3" onclick="snap-preset:2">1/4</button>
			<button id="snap-option-4" onclick="snap-preset:3">1/2</button>
			<button id="snap-option-5" onclick="snap-preset:4">1</button>
			<button id="snap-option-6" onclick="snap-preset:5">2</button>
			<button id="snap-option-7" onclick="snap-preset:6">4</button>
			<button id="snap-option-8" onclick="snap-preset:7">8</button>
		</div>

		<section class="transport">
			<div class="transport-group">
				<button class="transport-button" onclick="stop"><span class="stop-icon"></span><small>STOP</small></button>
				<button id="play-button" class="transport-button play" onclick="play"><span class="play-icon"></span><small id="play-label">PLAY</small></button>
				<button id="mock-record" class="transport-button record" title="アームしたトラックへ音声・MIDI録音" onclick="mock-record"><span class="record-icon"></span><small>REC</small></button>
				<button class="transport-button loop" title="ループ再生" onclick="loop"><span class="loop-icon"><i class="loop-forward"></i><i class="loop-back"></i><span class="loop-arrow-forward"></span><span class="loop-arrow-back"></span></span><small>LOOP</small></button>
			</div>
			<div class="position-block"><small>POSITION</small><b id="position"><span id="position-digit-0">0</span><span id="position-digit-1">1</span><i>.</i><span id="position-digit-2">0</span><span id="position-digit-3">1</span><i>.</i><span id="position-digit-4">0</span><span id="position-digit-5">0</span><span id="position-digit-6">0</span></b></div>
			<div class="tempo-block"><small>TEMPO</small><b id="tempo-value" onmousedown="tempo-begin" title="上下ドラッグでテンポ変更">124.0</b><em>BPM</em></div>
			<div class="meter" title="マスター出力波形"><div class="wave-row"><span>L</span><transport-wave id="transport-wave-l" class="wave-canvas"></transport-wave></div><div class="wave-row"><span>R</span><transport-wave id="transport-wave-r" class="wave-canvas"></transport-wave></div></div>
			<div class="zoom"><span>ZOOM</span><button onclick="zoom-out">-</button><b id="zoom-value">100%</b><button onclick="zoom-in">+</button></div>
			<div class="transport-status">
				<div class="status-row"><span>SELECTED</span><b id="selection-name">TRACK1</b><button id="snap-button" class="snap-button active" onclick="snap"><span>SNAP</span><b id="snap-value">1 / 16</b></button></div>
				<div class="status-row"><span>RATE</span><b>48 kHz / Float32</b><em id="audio-xruns">XRUN 0</em></div>
			</div>
		</section>

		<main class="workspace">
			<aside class="track-panel">
				<div class="track-panel-head"><button class="add-audio" onclick="add-audio">＋Audio</button><button class="add-instruments" onclick="add-instruments">＋instruments</button><button class="add-automation" onclick="add-automation">＋Automation</button></div>
				<div id="track-list" class="track-list" onmousescroll="track-wheel">
				<div id="track-header-0" class="track-header selected" onclick="track:0" onmousedown="track-reorder:0"><button class="track-color-button" onclick="color-menu:0" ondblclick="block-double-click" title="トラックカラーを変更"><i id="track-color-0" class="track-color coral"></i></button><div class="track-copy"><input id="track-name-input-0" class="track-name-input" type="text" maxlength="64" onkeydown="rename-key" onblur="rename-blur" onclick="block-double-click"/><b id="track-name-0">TRACK1</b><small>(instruments)</small></div><div class="track-controls"><div class="track-ms-meter"><div class="track-ms"><button id="track-mute-0" onclick="track-mute:0" title="ミュート">M</button><button id="track-solo-0" onclick="track-solo:0" title="ソロ">S</button></div></div><div class="track-volume-group"><button id="track-vol-0" class="track-volume-slider" onmousedown="track-knob:vol:0" ondblclick="knob-reset:vol:0" title="音量：左右ドラッグ"><i id="track-vol-fill-0" class="volume-rail"></i><i id="track-vol-dial-0" class="volume-thumb"></i></button><div class="track-mini-meter"><i id="track-meter-l-0"></i></div><div class="track-mini-meter"><i id="track-meter-r-0"></i></div><small id="track-vol-value-0">0.0</small></div><div class="track-knob-group"><button id="track-pan-0" class="track-knob pan-knob" onmousedown="track-knob:pan:0" ondblclick="knob-reset:pan:0" title="パン：上下ドラッグ"><div id="track-pan-dial-0" class="knob-dial"><i></i></div></button><small id="track-pan-value-0">C</small></div></div></div>
				<div id="track-header-1" class="track-header" onclick="track:1" onmousedown="track-reorder:1"><button class="track-color-button" onclick="color-menu:1" ondblclick="block-double-click" title="トラックカラーを変更"><i id="track-color-1" class="track-color amber"></i></button><div class="track-copy"><input id="track-name-input-1" class="track-name-input" type="text" maxlength="64" onkeydown="rename-key" onblur="rename-blur" onclick="block-double-click"/><b id="track-name-1">TRACK2</b><small>(instruments)</small></div><div class="track-controls"><div class="track-ms-meter"><div class="track-ms"><button id="track-mute-1" onclick="track-mute:1" title="ミュート">M</button><button id="track-solo-1" onclick="track-solo:1" title="ソロ">S</button></div></div><div class="track-volume-group"><button id="track-vol-1" class="track-volume-slider" onmousedown="track-knob:vol:1" ondblclick="knob-reset:vol:1" title="音量：左右ドラッグ"><i id="track-vol-fill-1" class="volume-rail"></i><i id="track-vol-dial-1" class="volume-thumb"></i></button><div class="track-mini-meter"><i id="track-meter-l-1"></i></div><div class="track-mini-meter"><i id="track-meter-r-1"></i></div><small id="track-vol-value-1">0.0</small></div><div class="track-knob-group"><button id="track-pan-1" class="track-knob pan-knob" onmousedown="track-knob:pan:1" ondblclick="knob-reset:pan:1" title="パン：上下ドラッグ"><div id="track-pan-dial-1" class="knob-dial"><i></i></div></button><small id="track-pan-value-1">C</small></div></div></div>
				<div id="track-header-2" class="track-header" onclick="track:2" onmousedown="track-reorder:2"><button class="track-color-button" onclick="color-menu:2" ondblclick="block-double-click" title="トラックカラーを変更"><i id="track-color-2" class="track-color violet"></i></button><div class="track-copy"><input id="track-name-input-2" class="track-name-input" type="text" maxlength="64" onkeydown="rename-key" onblur="rename-blur" onclick="block-double-click"/><b id="track-name-2">TRACK3</b><small>(instruments)</small></div><div class="track-controls"><div class="track-ms-meter"><div class="track-ms"><button id="track-mute-2" onclick="track-mute:2" title="ミュート">M</button><button id="track-solo-2" onclick="track-solo:2" title="ソロ">S</button></div></div><div class="track-volume-group"><button id="track-vol-2" class="track-volume-slider" onmousedown="track-knob:vol:2" ondblclick="knob-reset:vol:2" title="音量：左右ドラッグ"><i id="track-vol-fill-2" class="volume-rail"></i><i id="track-vol-dial-2" class="volume-thumb"></i></button><div class="track-mini-meter"><i id="track-meter-l-2"></i></div><div class="track-mini-meter"><i id="track-meter-r-2"></i></div><small id="track-vol-value-2">0.0</small></div><div class="track-knob-group"><button id="track-pan-2" class="track-knob pan-knob" onmousedown="track-knob:pan:2" ondblclick="knob-reset:pan:2" title="パン：上下ドラッグ"><div id="track-pan-dial-2" class="knob-dial"><i></i></div></button><small id="track-pan-value-2">C</small></div></div></div>
				<div id="track-header-3" class="track-header" onclick="track:3" onmousedown="track-reorder:3"><button class="track-color-button" onclick="color-menu:3" ondblclick="block-double-click" title="トラックカラーを変更"><i id="track-color-3" class="track-color cyan"></i></button><div class="track-copy"><input id="track-name-input-3" class="track-name-input" type="text" maxlength="64" onkeydown="rename-key" onblur="rename-blur" onclick="block-double-click"/><b id="track-name-3">TRACK4</b><small>(Audio)</small></div><div class="track-controls"><div class="track-ms-meter"><div class="track-ms"><button id="track-mute-3" onclick="track-mute:3" title="ミュート">M</button><button id="track-solo-3" onclick="track-solo:3" title="ソロ">S</button></div></div><div class="track-volume-group"><button id="track-vol-3" class="track-volume-slider" onmousedown="track-knob:vol:3" ondblclick="knob-reset:vol:3" title="音量：左右ドラッグ"><i id="track-vol-fill-3" class="volume-rail"></i><i id="track-vol-dial-3" class="volume-thumb"></i></button><div class="track-mini-meter"><i id="track-meter-l-3"></i></div><div class="track-mini-meter"><i id="track-meter-r-3"></i></div><small id="track-vol-value-3">0.0</small></div><div class="track-knob-group"><button id="track-pan-3" class="track-knob pan-knob" onmousedown="track-knob:pan:3" ondblclick="knob-reset:pan:3" title="パン：上下ドラッグ"><div id="track-pan-dial-3" class="knob-dial"><i></i></div></button><small id="track-pan-value-3">C</small></div></div></div>
				<div id="track-header-4" class="track-header" onclick="track:4" onmousedown="track-reorder:4"><button class="track-color-button" onclick="color-menu:4" ondblclick="block-double-click" title="トラックカラーを変更"><i id="track-color-4" class="track-color pink"></i></button><div class="track-copy"><input id="track-name-input-4" class="track-name-input" type="text" maxlength="64" onkeydown="rename-key" onblur="rename-blur" onclick="block-double-click"/><b id="track-name-4">TRACK5</b><small>(Audio)</small></div><div class="track-controls"><div class="track-ms-meter"><div class="track-ms"><button id="track-mute-4" onclick="track-mute:4" title="ミュート">M</button><button id="track-solo-4" onclick="track-solo:4" title="ソロ">S</button></div></div><div class="track-volume-group"><button id="track-vol-4" class="track-volume-slider" onmousedown="track-knob:vol:4" ondblclick="knob-reset:vol:4" title="音量：左右ドラッグ"><i id="track-vol-fill-4" class="volume-rail"></i><i id="track-vol-dial-4" class="volume-thumb"></i></button><div class="track-mini-meter"><i id="track-meter-l-4"></i></div><div class="track-mini-meter"><i id="track-meter-r-4"></i></div><small id="track-vol-value-4">0.0</small></div><div class="track-knob-group"><button id="track-pan-4" class="track-knob pan-knob" onmousedown="track-knob:pan:4" ondblclick="knob-reset:pan:4" title="パン：上下ドラッグ"><div id="track-pan-dial-4" class="knob-dial"><i></i></div></button><small id="track-pan-value-4">C</small></div></div></div>
				<div id="track-header-5" class="track-header master" onclick="track:5" onmousedown="track-reorder:5"><button class="track-color-button" onclick="color-menu:5" ondblclick="block-double-click" title="トラックカラーを変更"><i id="track-color-5" class="track-color mint"></i></button><div class="track-copy"><b id="track-name-5">MASTER</b><small>Stereo Out</small></div><div class="track-controls"><div class="track-ms-meter"></div><div class="track-volume-group"><button id="track-vol-5" class="track-volume-slider" onmousedown="track-knob:vol:5" ondblclick="knob-reset:vol:5" title="音量：左右ドラッグ"><i id="track-vol-fill-5" class="volume-rail"></i><i id="track-vol-dial-5" class="volume-thumb"></i></button><div class="track-mini-meter"><i id="track-meter-l-5"></i></div><div class="track-mini-meter"><i id="track-meter-r-5"></i></div><small id="track-vol-value-5">0.0</small></div><div class="track-knob-group"><button id="track-pan-5" class="track-knob pan-knob" onmousedown="track-knob:pan:5" ondblclick="knob-reset:pan:5" title="パン：上下ドラッグ"><div id="track-pan-dial-5" class="knob-dial"><i></i></div></button><small id="track-pan-value-5">C</small></div></div></div>
				</div>
			</aside>

			<section id="timeline-viewport" class="timeline-viewport">
				<div id="ruler-canvas" class="ruler-canvas" onmousedown="ruler-pointer" onmousemove="scrub-move" onmouseup="scrub-end">
					<div id="loop-range" class="loop-range"><span>ループ範囲</span></div>
					<div class="bar-marker" id="bar-1"><b>1</b></div><div class="bar-marker" id="bar-2"><b>2</b></div><div class="bar-marker" id="bar-3"><b>3</b></div><div class="bar-marker" id="bar-4"><b>4</b></div><div class="bar-marker" id="bar-5"><b>5</b></div><div class="bar-marker" id="bar-6"><b>6</b></div><div class="bar-marker" id="bar-7"><b>7</b></div><div class="bar-marker" id="bar-8"><b>8</b></div><div class="bar-marker" id="bar-9"><b>9</b></div><div class="bar-marker" id="bar-10"><b>10</b></div><div class="bar-marker" id="bar-11"><b>11</b></div><div class="bar-marker" id="bar-12"><b>12</b></div><div class="bar-marker" id="bar-13"><b>13</b></div><div class="bar-marker" id="bar-14"><b>14</b></div><div class="bar-marker" id="bar-15"><b>15</b></div><div class="bar-marker" id="bar-16"><b>16</b></div><div class="bar-marker" id="bar-17"><b>17</b></div><div class="bar-marker" id="bar-18"><b>18</b></div><div class="bar-marker" id="bar-19"><b>19</b></div><div class="bar-marker" id="bar-20"><b>20</b></div><div class="bar-marker" id="bar-21"><b>21</b></div><div class="bar-marker" id="bar-22"><b>22</b></div><div class="bar-marker" id="bar-23"><b>23</b></div><div class="bar-marker" id="bar-24"><b>24</b></div><div class="bar-marker" id="bar-25"><b>25</b></div><div class="bar-marker" id="bar-26"><b>26</b></div><div class="bar-marker" id="bar-27"><b>27</b></div><div class="bar-marker" id="bar-28"><b>28</b></div><div class="bar-marker" id="bar-29"><b>29</b></div><div class="bar-marker" id="bar-30"><b>30</b></div><div class="bar-marker" id="bar-31"><b>31</b></div><div class="bar-marker" id="bar-32"><b>32</b></div><div class="bar-marker" id="bar-33"><b>33</b></div>
				</div>

				<div id="lane-canvas" class="lane-canvas" onmousemove="scrub-move" onmouseup="scrub-end" onmousedown="empty-lane-context">
					<div id="grid-overlay" class="grid-overlay">
						<div id="band-2" class="bar-band"></div><div id="band-4" class="bar-band"></div><div id="band-6" class="bar-band"></div><div id="band-8" class="bar-band"></div><div id="band-10" class="bar-band"></div><div id="band-12" class="bar-band"></div><div id="band-14" class="bar-band"></div><div id="band-16" class="bar-band"></div><div id="band-18" class="bar-band"></div><div id="band-20" class="bar-band"></div><div id="band-22" class="bar-band"></div><div id="band-24" class="bar-band"></div><div id="band-26" class="bar-band"></div><div id="band-28" class="bar-band"></div><div id="band-30" class="bar-band"></div><div id="band-32" class="bar-band"></div>
						<div id="beat-0" class="beat-line bar"></div><div id="beat-1" class="beat-line"></div><div id="beat-2" class="beat-line"></div><div id="beat-3" class="beat-line"></div><div id="beat-4" class="beat-line bar"></div><div id="beat-5" class="beat-line"></div><div id="beat-6" class="beat-line"></div><div id="beat-7" class="beat-line"></div><div id="beat-8" class="beat-line bar"></div><div id="beat-9" class="beat-line"></div><div id="beat-10" class="beat-line"></div><div id="beat-11" class="beat-line"></div><div id="beat-12" class="beat-line bar"></div><div id="beat-13" class="beat-line"></div><div id="beat-14" class="beat-line"></div><div id="beat-15" class="beat-line"></div><div id="beat-16" class="beat-line bar"></div><div id="beat-17" class="beat-line"></div><div id="beat-18" class="beat-line"></div><div id="beat-19" class="beat-line"></div><div id="beat-20" class="beat-line bar"></div><div id="beat-21" class="beat-line"></div><div id="beat-22" class="beat-line"></div><div id="beat-23" class="beat-line"></div><div id="beat-24" class="beat-line bar"></div><div id="beat-25" class="beat-line"></div><div id="beat-26" class="beat-line"></div><div id="beat-27" class="beat-line"></div><div id="beat-28" class="beat-line bar"></div><div id="beat-29" class="beat-line"></div><div id="beat-30" class="beat-line"></div><div id="beat-31" class="beat-line"></div><div id="beat-32" class="beat-line bar"></div><div id="beat-33" class="beat-line"></div><div id="beat-34" class="beat-line"></div><div id="beat-35" class="beat-line"></div><div id="beat-36" class="beat-line bar"></div><div id="beat-37" class="beat-line"></div><div id="beat-38" class="beat-line"></div><div id="beat-39" class="beat-line"></div><div id="beat-40" class="beat-line bar"></div><div id="beat-41" class="beat-line"></div><div id="beat-42" class="beat-line"></div><div id="beat-43" class="beat-line"></div><div id="beat-44" class="beat-line bar"></div><div id="beat-45" class="beat-line"></div><div id="beat-46" class="beat-line"></div><div id="beat-47" class="beat-line"></div><div id="beat-48" class="beat-line bar"></div><div id="beat-49" class="beat-line"></div><div id="beat-50" class="beat-line"></div><div id="beat-51" class="beat-line"></div><div id="beat-52" class="beat-line bar"></div><div id="beat-53" class="beat-line"></div><div id="beat-54" class="beat-line"></div><div id="beat-55" class="beat-line"></div><div id="beat-56" class="beat-line bar"></div><div id="beat-57" class="beat-line"></div><div id="beat-58" class="beat-line"></div><div id="beat-59" class="beat-line"></div><div id="beat-60" class="beat-line bar"></div><div id="beat-61" class="beat-line"></div><div id="beat-62" class="beat-line"></div><div id="beat-63" class="beat-line"></div><div id="beat-64" class="beat-line bar"></div><div id="beat-65" class="beat-line"></div><div id="beat-66" class="beat-line"></div><div id="beat-67" class="beat-line"></div><div id="beat-68" class="beat-line bar"></div><div id="beat-69" class="beat-line"></div><div id="beat-70" class="beat-line"></div><div id="beat-71" class="beat-line"></div><div id="beat-72" class="beat-line bar"></div><div id="beat-73" class="beat-line"></div><div id="beat-74" class="beat-line"></div><div id="beat-75" class="beat-line"></div><div id="beat-76" class="beat-line bar"></div><div id="beat-77" class="beat-line"></div><div id="beat-78" class="beat-line"></div><div id="beat-79" class="beat-line"></div><div id="beat-80" class="beat-line bar"></div><div id="beat-81" class="beat-line"></div><div id="beat-82" class="beat-line"></div><div id="beat-83" class="beat-line"></div><div id="beat-84" class="beat-line bar"></div><div id="beat-85" class="beat-line"></div><div id="beat-86" class="beat-line"></div><div id="beat-87" class="beat-line"></div><div id="beat-88" class="beat-line bar"></div><div id="beat-89" class="beat-line"></div><div id="beat-90" class="beat-line"></div><div id="beat-91" class="beat-line"></div><div id="beat-92" class="beat-line bar"></div><div id="beat-93" class="beat-line"></div><div id="beat-94" class="beat-line"></div><div id="beat-95" class="beat-line"></div><div id="beat-96" class="beat-line bar"></div><div id="beat-97" class="beat-line"></div><div id="beat-98" class="beat-line"></div><div id="beat-99" class="beat-line"></div><div id="beat-100" class="beat-line bar"></div><div id="beat-101" class="beat-line"></div><div id="beat-102" class="beat-line"></div><div id="beat-103" class="beat-line"></div><div id="beat-104" class="beat-line bar"></div><div id="beat-105" class="beat-line"></div><div id="beat-106" class="beat-line"></div><div id="beat-107" class="beat-line"></div><div id="beat-108" class="beat-line bar"></div><div id="beat-109" class="beat-line"></div><div id="beat-110" class="beat-line"></div><div id="beat-111" class="beat-line"></div><div id="beat-112" class="beat-line bar"></div><div id="beat-113" class="beat-line"></div><div id="beat-114" class="beat-line"></div><div id="beat-115" class="beat-line"></div><div id="beat-116" class="beat-line bar"></div><div id="beat-117" class="beat-line"></div><div id="beat-118" class="beat-line"></div><div id="beat-119" class="beat-line"></div><div id="beat-120" class="beat-line bar"></div><div id="beat-121" class="beat-line"></div><div id="beat-122" class="beat-line"></div><div id="beat-123" class="beat-line"></div><div id="beat-124" class="beat-line bar"></div><div id="beat-125" class="beat-line"></div><div id="beat-126" class="beat-line"></div><div id="beat-127" class="beat-line"></div><div id="beat-128" class="beat-line bar"></div>
					</div>
					<div id="track-lane-0" class="lane drums"><div id="clip-drums-a" class="clip coral" onmousedown="clip-drag:clip-drums-a" ondblclick="open-piano:0" onclick="clip:Verse Drums"><b>VERSE DRUMS</b><span class="steps">x x · x · x x · x x · x · x x ·</span></div><div id="clip-drums-b" class="clip coral" onmousedown="clip-drag:clip-drums-b" ondblclick="open-piano:0" onclick="clip:Chorus Drums"><b>CHORUS DRUMS</b><span class="steps">x x x x · x x · x x x x · x x ·</span></div><div id="clip-drums-c" class="clip coral" onmousedown="clip-drag:clip-drums-c" ondblclick="open-piano:0" onclick="clip:Verse Drums 2"><b>VERSE DRUMS</b><span class="steps">x x · x · x x · x x · x · x x ·</span></div><div id="clip-drums-d" class="clip coral dim" onmousedown="clip-drag:clip-drums-d" ondblclick="open-piano:0" onclick="clip:Outro Drums"><b>OUTRO</b></div></div>
					<div id="track-lane-1" class="lane bass"><div id="clip-bass-a" class="clip amber" onmousedown="clip-drag:clip-bass-a" ondblclick="open-piano:1" onclick="clip:Bass A"><b>BASS A</b><span class="notes"><i></i><i></i><i></i><i></i><i></i></span></div><div id="clip-bass-b" class="clip amber" onmousedown="clip-drag:clip-bass-b" ondblclick="open-piano:1" onclick="clip:Bass B"><b>BASS B</b><span class="notes"><i></i><i></i><i></i><i></i></span></div><div id="clip-bass-c" class="clip amber" onmousedown="clip-drag:clip-bass-c" ondblclick="open-piano:1" onclick="clip:Bass C"><b>BASS C</b><span class="notes"><i></i><i></i><i></i><i></i></span></div><div id="clip-bass-d" class="clip amber dim" onmousedown="clip-drag:clip-bass-d" ondblclick="open-piano:1" onclick="clip:Bass End"><b>END</b></div></div>
					<div id="track-lane-2" class="lane keys"><div id="clip-keys-a" class="clip violet" onmousedown="clip-drag:clip-keys-a" ondblclick="open-piano:2" onclick="clip:Neon Chords"><b>NEON CHORDS</b><span class="chords">Am9 &#160; Fmaj7 &#160; Cmaj9 &#160; G6</span></div><div id="clip-keys-b" class="clip violet" onmousedown="clip-drag:clip-keys-b" ondblclick="open-piano:2" onclick="clip:Glass Arp"><b>GLASS ARP</b><span class="steps">· · x · x · · x · x · x · · x ·</span></div></div>
					<div id="track-lane-3" class="lane vocal"><div id="clip-vocal-a" class="clip cyan audio" onmousedown="clip-drag:clip-vocal-a" ondblclick="open-piano:3" onclick="clip:Lead Vocal 01"><b>LEAD VOCAL 01</b><span class="waveform">▂▅▃▇▄▆▂▅▇▃▆▄▂▇▅▃</span></div><div id="clip-vocal-b" class="clip cyan audio" onmousedown="clip-drag:clip-vocal-b" ondblclick="open-piano:3" onclick="clip:Lead Vocal 02"><b>LEAD VOCAL 02</b><span class="waveform">▅▂▆▇▃▄▇▅▂▆▃▇▄▅▂▆</span></div></div>
					<div id="track-lane-4" class="lane texture"><div id="clip-fx-a" class="clip pink audio" onmousedown="clip-drag:clip-fx-a" ondblclick="open-piano:4" onclick="clip:Reverse Bloom"><b>REVERSE BLOOM</b><span class="waveform">▁▂▃▄▅▆▇█</span></div><div id="clip-fx-b" class="clip pink audio" onmousedown="clip-drag:clip-fx-b" ondblclick="open-piano:4" onclick="clip:Noise Lift"><b>NOISE LIFT</b><span class="waveform">▂▂▃▄▅▆▆▇</span></div></div>
					<div id="track-lane-5" class="lane master"><div id="clip-master-a" class="clip mint region" onmousedown="clip-drag:clip-master-a" ondblclick="open-piano:5" onclick="clip:Arrangement"><b>ARRANGEMENT</b><span>INTRO</span><span>VERSE</span><span>CHORUS</span><span>BREAK</span><span>OUTRO</span></div></div>
					<div id="playhead-line" class="playhead-line"><span></span></div>
				</div>
			</section>
		</main>
		<div id="mock-notice" class="mock-notice"></div>
		<div id="loop-context-menu" class="loop-context-menu">
			<button onclick="set-loop-begin">ここをループ開始位置に設定</button>
			<button onclick="set-loop-end">ここをループ終了位置に設定</button>
		</div>
		<div id="empty-lane-menu" class="clip-context-menu"><button id="empty-lane-paste" onclick="empty-lane-paste">貼り付け</button></div>
		<div id="clip-context-menu" class="clip-context-menu"><button onclick="clip-cut">切り取り</button><button onclick="clip-copy">コピー</button><button id="clip-menu-paste" onclick="clip-paste">貼り付け</button><button onclick="clip-delete">削除</button></div>
		<div id="track-color-menu" class="track-color-menu">
			<b>トラックカラー</b><span id="color-track-name"></span>
			<div class="color-preset-row"><button id="color-preset-0" class="color-swatch coral" onclick="color-preset:0" title="コーラル"></button><button id="color-preset-1" class="color-swatch amber" onclick="color-preset:1" title="アンバー"></button><button id="color-preset-2" class="color-swatch violet" onclick="color-preset:2" title="パープル"></button></div>
			<div class="color-preset-row"><button id="color-preset-3" class="color-swatch cyan" onclick="color-preset:3" title="シアン"></button><button id="color-preset-4" class="color-swatch pink" onclick="color-preset:4" title="ピンク"></button><button id="color-preset-5" class="color-swatch mint" onclick="color-preset:5" title="ミント"></button></div>
			<div class="color-preset-row"><button id="color-preset-6" class="color-swatch blue" onclick="color-preset:6" title="ブルー"></button><button id="color-preset-7" class="color-swatch orange" onclick="color-preset:7" title="オレンジ"></button><button id="color-preset-8" class="color-swatch slate" onclick="color-preset:8" title="グレー"></button></div>
		</div>
		<div id="track-fx-menu" class="track-fx-menu"><b>エフェクトチェイン</b><span id="track-fx-name"></span><button id="track-effect-0" onclick="track-effect:0">EQ</button><button id="track-effect-1" onclick="track-effect:1">Compressor</button><button id="track-effect-2" onclick="track-effect:2">Reverb</button><small>クリックでON・OFF</small></div>

	</div>
</body>
</rml>
