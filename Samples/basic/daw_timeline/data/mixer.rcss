* { box-sizing: border-box; font-family: LINESeedJP; font-weight: bold; }
body { width: 100%; height: 100%; margin: 0; overflow: hidden; color: #ced5dc; background: #0b0d10; font-size: 11dp; }
button { display: block; padding: 0; border: 1dp #3b424a; color: #ced5dc; background: #24282d; text-align: center; }
button:hover { color: #f3fafc; background: #333b43; }
button.active { border-color: #58cede; color: #71e2f0; background: #17313a; }
#mixer-app { display: flex; width: 100%; height: 100%; flex-direction: column; background: #101114; }
.mixer-heading { display: flex; flex: 0 0 30dp; height: 30dp; align-items: center; padding: 0 12dp; border-bottom: 1dp #333840; background: #0c0d10; }
.mixer-heading span { margin-left: auto; color: #65747f; font-size: 9dp; }
#mixer-pin { position: relative; flex: 0 0 26dp; width: 26dp; height: 24dp; margin-left: 10dp; border: 1dp #364452; background: #171e27; }
#mixer-pin:hover { background: #263342; }
#mixer-pin.pinned { border-color: #ffdb28; background: #494009; }
#mixer-pin.pinned:hover { background: #60520c; }
#mixer-pin i { display: block; position: absolute; background: #9aabba; pointer-events: none; }
#mixer-pin.pinned i { background: #ffe337; }
#mixer-pin .pin-head { left: 9dp; top: 5dp; width: 6dp; height: 2dp; }
#mixer-pin .pin-neck { left: 10dp; top: 7dp; width: 4dp; height: 7dp; }
#mixer-pin .pin-base { left: 8dp; top: 14dp; width: 8dp; height: 2dp; }
#mixer-pin .pin-point { left: 11dp; top: 16dp; width: 2dp; height: 4dp; }
.mixer-workspace { display: flex; flex: 1 1 0; height: 0; min-height: 0; padding: 10dp; overflow-x: auto; overflow-y: hidden; }
.current-meter { display: flex; flex: 0 0 64dp; width: 64dp; flex-direction: column; margin-right: 10dp; }
.current-meter > b { height: 20dp; font-size: 10dp; text-align: center; }
.meter-body { position: relative; flex: 1 1 0; min-height: 120dp; }
.stereo-meter { display: flex; position: absolute; top: 0; bottom: 0; left: 0; width: 36dp; border: 1dp #495057; background: #080a0b; }
.level-column { display: block; position: relative; flex: 1 1 0; height: 100%; margin: 0 2dp; border-right: 1dp #29343a; }
.level-column i { display: block; position: absolute; bottom: 0; width: 100%; height: 32%; background: #38878a; }
.level-column:last-child i { height: 28%; }
.db-scale { position: absolute; top: 0; bottom: 0; left: 38dp; width: 25dp; font-size: 9dp; color: #a1aeb9; }
.db-scale span { display: block; position: absolute; left: 0; line-height: 12dp; }
.db-top { top: 0; }.db-zero { top: 11%; }.db-six { top: 22%; }.db-twelve { top: 33%; }.db-twentyfour { top: 55%; }.db-bottom { bottom: 0; }
.master-strip { display: flex; flex: 0 0 76dp; width: 76dp; height: 100%; margin-right: 8dp; flex-direction: column; align-items: center; padding: 8dp 5dp; border: 2dp #58d4e7; background: #090c10; }
.master-strip:last-child { margin-right: 0; }
.channel-name { display: block; width: 62dp; height: 23dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #edf6fa; font-size: 10dp; line-height: 20dp; text-align: center; }
.gain-value { display: block; width: 56dp; height: 26dp; margin-bottom: 7dp; color: #65dbea; background: #050607; font-size: 10dp; line-height: 26dp; text-align: center; }
.channel-controls { display: flex; flex: 0 0 22dp; margin-bottom: 15dp; }
.channel-controls button { width: 23dp; height: 22dp; margin: 0 2dp; border-radius: 2dp; font-size: 10dp; line-height: 20dp; }
.channel-fader-area { display: flex; flex: 1 1 0; width: 56dp; height: 0; min-height: 90dp; margin-bottom: 12dp; }
.fader-rail { display: block; position: relative; flex: 0 0 32dp; width: 32dp; height: 100%; cursor: move; }
.channel-meter { display: flex; flex: 0 0 18dp; width: 18dp; height: 100%; margin-left: 6dp; padding: 1dp; border: 1dp #263944; background: #030609; pointer-events: none; }
.channel-meter-column { display: block; position: relative; flex: 1 1 0; height: 100%; overflow: hidden; clip: always; background: #0e1820; }
.channel-meter-column:first-child { margin-right: 2dp; }
.channel-meter-fill { display: block; position: absolute; bottom: 0; width: 100%; height: 0%; background: #21c5df; }
.fader-groove { display: block; position: absolute; left: 13dp; top: 0; bottom: 0; width: 6dp; border-left: 1dp #25333d; background: #030506; pointer-events: none; }
.unity-line { position: absolute; left: 0; top: 11.11%; width: 32dp; height: 1dp; background: #375461; pointer-events: none; }
.fader-thumb { display: block; position: absolute; left: 4dp; top: 11.11%; width: 24dp; height: 26dp; margin-top: -13dp; border: 1dp #405969; border-radius: 3dp; background: #283c48; pointer-events: none; }
.fader-thumb i { display: block; height: 3dp; margin-top: 11dp; background: #55d7ed; }
.master-strip > small { color: #6f8795; font-size: 8dp; }
.channel-space { display: block; flex: 1 1 0; width: 0; min-width: 0; height: 100%; margin-right: 10dp; overflow-x: scroll; overflow-y: hidden; }
.channel-space scrollbarhorizontal { height: 16dp; background: #10161e; border-top: 1dp #303b48; }
.channel-space scrollbarhorizontal slidertrack { height: 15dp; background: #10161e; }
.channel-space scrollbarhorizontal sliderbar { height: 11dp; min-width: 24dp; margin-top: 2dp; border: 1dp #526272; border-radius: 3dp; background: #354554; }
.channel-space scrollbarhorizontal sliderbar:hover { border-color: #7d9aab; background: #4a6275; }
.channel-space scrollbarhorizontal sliderbar:active { border-color: #74e0cf; background: #397f78; }
.channel-space scrollbarhorizontal sliderarrowdec, .channel-space scrollbarhorizontal sliderarrowinc { width: 16dp; height: 15dp; border: 1dp #344454; background: #222e3a; }
.channel-space scrollbarhorizontal sliderarrowdec:hover, .channel-space scrollbarhorizontal sliderarrowinc:hover { background: #415669; }
.mixer-channels { display: flex; width: 496dp; height: 100%; padding-bottom: 16dp; }
.channel-space > small { margin-bottom: 8dp; color: #596572; font-size: 10dp; }
.channel-space > span { font-size: 9dp; text-align: center; }
.effects-panel { display: flex; flex: 0 0 280dp; width: 280dp; min-height: 0; flex-direction: column; padding: 7dp; border: 1dp #30343b; background: #141518; }
.effects-panel > header { display: flex; flex: 0 0 25dp; height: 25dp; color: #e0e8ed; font-size: 11dp; line-height: 20dp; }
.effects-panel > header > b { display: block; flex: 0 0 40dp; width: 40dp; height: 20dp; }
#rack-channel-name { flex: 1 1 0; min-width: 0; margin-left: 12dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; text-align: right; color: #71a7b4; font-size: 10dp; }
.effects-scroll { flex: 1 1 0; height: 0; min-height: 0; padding: 5dp; overflow-y: auto; overflow-x: hidden; border: 1dp #25292e; background: #0a0b0d; }
#effects-empty { margin: 12dp 0; color: #515d68; font-size: 10dp; text-align: center; }
.effect-row { display: flex; height: 36dp; align-items: center; margin-bottom: 5dp; padding: 3dp; border: 1dp #303c47; background: #171d23; }
.effect-row b { flex: 1 1 0; min-width: 0; padding-left: 9dp; font-size: 10dp; }
.vst-effect-row { height: 44dp; }
.vst-editor-button { flex: 1 1 0; min-width: 0; height: 38dp; margin: 0 3dp; padding: 1dp 4dp; text-align: left; overflow: hidden; }
.vst-editor-button b { display: block; padding-left: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.vst-editor-button small { display: block; font-size: 8dp; color: #8296a3; }
.effect-toggle { width: 30dp; height: 26dp; font-size: 9dp; line-height: 24dp; }
.effect-remove { width: 25dp; height: 26dp; border: 0; font-size: 10dp; line-height: 26dp; }
.add-effect { flex: 0 0 28dp; width: 100%; height: 28dp; margin-top: 7dp; font-size: 11dp; line-height: 26dp; }
.mixer-footer { display: flex; flex: 0 0 25dp; height: 25dp; align-items: center; padding: 0 10dp; border-top: 1dp #30343b; color: #61727e; background: #0c0d10; font-size: 9dp; }
.mixer-footer small { margin-left: 15dp; font-size: 9dp; }
.mixer-footer b { margin-left: auto; color: #6f8993; }
@media (max-width: 700dp) { .effects-panel { flex-basis: 230dp; width: 230dp; }.channel-space { min-width: 70dp; }.channel-space > span { display: none; }.mixer-footer small { display: none; } }
