* { box-sizing: border-box; font-family: LINESeedJP; font-weight: bold; }
body { width: 100%; height: 100%; margin: 0; overflow: hidden; color: #d5e3ed; background: #090e14; font-size: 11dp; line-height: 18dp; }
button { display: block; padding: 0; border: 1dp #344657; color: #c8d8e5; background: #141f2a; text-align: center; }
button:hover { background: #233747; color: #effaff; }button.active { color: #6eeaff; border-color: #29c7e3; background: #103442; }
#plugin-app { display: flex; flex-direction: column; width: 100%; height: 100%; }
nav { display: flex; flex: 0 0 46dp; height: 46dp; align-items: center; padding: 6dp 10dp; border-bottom: 1dp #304354; background: #060b10; }
nav button { width: 66dp; height: 32dp; margin-right: 4dp; line-height: 30dp; border: 1dp #060b10; background: #060b10; }#plugin-tab-2 { width: 116dp; }
#plugin-pin { width: 30dp; margin-left: auto; margin-right: 0; border-color: #344657; background: #141f2a; font-size: 18dp; }#plugin-pin.pinned { color: #ffe337; border-color: #f1d127; background: #494009; }
header { display: flex; flex: 0 0 30dp; height: 30dp; padding: 0 12dp; align-items: center; border-bottom: 1dp #253644; }header b { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }header span { margin-left: 8dp; color: #698595; font-size: 9dp; }
main { display: flex; flex: 1 1 0; height: 0; min-height: 0; }
.plugin-page { display: none; flex: 1 1 0; min-width: 0; min-height: 0; width: 100%; height: 100%; flex-direction: column; padding: 12dp; overflow-x: hidden; overflow-y: auto; }
footer { flex: 0 0 24dp; height: 24dp; padding: 0 10dp; line-height: 23dp; border-top: 1dp #273947; color: #698594; font-size: 9dp; }
p { margin: 6dp 0 10dp; color: #7798a9; font-size: 10dp; line-height: 18dp; }
.gui-brand { display: block; flex: 0 0 100dp; height: 100dp; padding: 12dp 16dp; color: #122832; background: #a6bdc9; }.gui-brand b { display: block; height: 43dp; font-size: 35dp; line-height: 43dp; }.gui-brand span, .gui-brand small { display: block; font-size: 10dp; line-height: 17dp; }
.gui-controls { display: flex; flex: 0 0 140dp; height: 140dp; padding: 14dp 6dp; background: #89a5b2; color: #142732; }.gui-controls > div { display: flex; flex: 1 1 0; min-width: 0; align-items: center; flex-direction: column; }.gui-controls b { font-size: 9dp; line-height: 20dp; }.gui-controls button { position: relative; width: 42dp; height: 42dp; margin: 8dp 0; border: 3dp #526f7d; border-radius: 23dp; background: #243d49; }.gui-controls button i { display: block; position: absolute; left: 17dp; top: 3dp; width: 2dp; height: 12dp; background: #a8e2ef; }.gui-controls span { display: block; width: 90%; height: 22dp; line-height: 22dp; background: #243d49; color: #abe8f5; text-align: center; font-size: 9dp; }
.gui-bands { display: block; flex: 0 0 160dp; height: 160dp; padding: 15dp; background: #22423f; }.gui-bands > div { display: flex; height: 40dp; align-items: center; }.gui-bands b { width: 20dp; color: #9bc6b8; }.band-fill { display: block; flex: 1 1 0; height: 20dp; margin-right: 12dp; background: #4d8c71; }.band-fill.mid { background: #6ca292; }.band-fill.low { background: #91ada0; }.gui-bands span { width: 35dp; font-size: 9dp; color: #9cc9bc; }
.routing-card { display: block; padding: 12dp; margin-bottom: 12dp; border: 1dp #304758; background: #101c28; }.routing-title { display: flex; height: 30dp; align-items: center; margin-bottom: 8dp; }.routing-title b { flex: 1 1 0; }.routing-title button { width: 50dp; height: 26dp; line-height: 24dp; }.route-row { display: flex; height: 36dp; align-items: center; }.route-row span { width: 50dp; color: #92a8b9; font-size: 10dp; }.route-row button { width: 30dp; height: 28dp; line-height: 26dp; }.route-row b { display: block; width: 48dp; height: 28dp; margin: 0 5dp; border: 1dp #2bc7e3; color: #6de7fc; background: #10323f; text-align: center; line-height: 26dp; }
#plugin-connections { display: block; margin: 0 0 8dp; padding: 10dp; border: 1dp #254b51; background: #0c2428; color: #76dfd9; white-space: pre-wrap; line-height: 21dp; }.midi-page > small { font-size: 9dp; color: #698391; }
.parameter-page { overflow-y: hidden; }#plugin-search { display: block; flex: 0 0 32dp; width: 100%; height: 32dp; padding: 5dp 9dp; border: 1dp #425c70; background: #0e1822; color: #d8e8f3; font-size: 11dp; line-height: 20dp; }
.parameter-page > p { flex: 0 0 26dp; height: 26dp; margin: 4dp 0; font-size: 9dp; }
#plugin-param-scroll { display: block; flex: 1 1 0; height: 0; min-height: 0; overflow-y: auto; overflow-x: hidden; }#plugin-parameters { display: flex; flex-wrap: wrap; width: 100%; }
.parameter-card { display: block; flex: 0 0 50%; width: 50%; padding: 8dp; border-bottom: 1dp #253b4a; }.parameter-label { display: flex; height: 24dp; align-items: center; }.parameter-label b { flex: 1 1 0; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 10dp; }.parameter-label span { width: 43dp; color: #81dcf2; font-size: 10dp; text-align: right; }
.parameter-rail { display: block; position: relative; width: 100%; height: 22dp; margin-bottom: 8dp; border-top: 8dp #090e14; border-bottom: 8dp #090e14; background: #314454; cursor: move; }.parameter-fill { display: block; position: absolute; left: 0; top: 0; width: 50%; height: 6dp; background: #26c4dc; pointer-events: none; }.parameter-thumb { display: block; position: absolute; left: 50%; top: -4dp; width: 8dp; height: 14dp; margin-left: -4dp; border: 1dp #c2eff8; background: #71e5f5; pointer-events: none; }
.binding-row { display: flex; height: 26dp; }.binding-row select { display: block; flex: 1 1 0; min-width: 0; height: 26dp; padding: 3dp 5dp; border: 1dp #334b5c; background: #101e2a; color: #a4c8d6; font-size: 9dp; line-height: 18dp; }.binding-row button { flex: 0 0 25dp; width: 25dp; height: 26dp; margin-left: 4dp; line-height: 24dp; color: #7ce3d4; }
select selectvalue { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }select selectarrow { width: 12dp; height: 16dp; background: #345367; }select selectbox { padding: 3dp; border: 1dp #415f71; background: #101f2b; }select option { display: block; padding: 3dp; line-height: 19dp; }select option:hover, select option:checked { color: #89f1df; background: #23434a; }
#plugin-param-empty { display: none; padding: 15dp; text-align: center; }
scrollbarvertical { width: 12dp; background: #111d28; }scrollbarvertical slidertrack { width: 12dp; }scrollbarvertical sliderbar { width: 10dp; min-height: 24dp; border-radius: 3dp; background: #3c5b6d; }scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
